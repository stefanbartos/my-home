---
interface Props {
    frontmatter?: { title?: string; lang?: string };
    title?: string;
}

const { frontmatter, title: titleProp } = Astro.props;
const title = titleProp ?? frontmatter?.title ?? "My home";
const lang = frontmatter?.lang ?? "cs";
---

<!DOCTYPE html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>

    <body>
        <main>
            <slot />
        </main>
    </body>
</html>
