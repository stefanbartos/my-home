---
import "../styles/global.css";
import type { MarkdownHeading } from "astro";
import Topo from "../components/Topo.astro";
import Toc from "../components/Toc.astro";
import { defaultLocale, homeUrl, url, useTranslations, type Locale } from "../i18n/ui";

interface Props {
    frontmatter?: { title?: string; description?: string; lang?: string; toc?: boolean };
    headings?: MarkdownHeading[];
    title?: string;
    description?: string;
    /** Language of the page content (html lang). Defaults to the UI locale. */
    lang?: string;
    /** Language of the site chrome (nav, footer). */
    locale?: Locale;
    /** URL of this page in the other locale, if a translation exists. */
    alternate?: string;
    wide?: boolean;
}

const { frontmatter, headings = [], wide = false } = Astro.props;
const locale: Locale = Astro.props.locale ?? defaultLocale;
const otherLocale: Locale = locale === "sk" ? "en" : "sk";
const t = useTranslations(locale);

const pageTitle = Astro.props.title ?? frontmatter?.title;
const title = pageTitle ? `${pageTitle} · Štefan Bartoš` : "Štefan Bartoš";
const description = Astro.props.description ?? frontmatter?.description ?? t("site.description");
const lang = Astro.props.lang ?? frontmatter?.lang ?? locale;
const alternate = Astro.props.alternate;
const switchHref = alternate ?? homeUrl(otherLocale);

const nav = [
    { href: url("/sci/"), label: t("nav.sci"), hold: "lime", lang: "cs" },
    { href: url("/prvni-pomoc/"), label: t("nav.firstAid"), hold: "pink", lang: "sk" },
    {
        href: url("/frontend-best-practices/"),
        label: t("nav.frontend"),
        hold: "violet",
        lang: "en",
    },
];
const current = Astro.url.pathname.replace(/\/?$/, "/");
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#fbf6ee" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#14121f" media="(prefers-color-scheme: dark)" />
        {alternate && (
            <>
                <link
                    rel="alternate"
                    hreflang={locale}
                    href={new URL(Astro.url.pathname, Astro.site)}
                />
                <link
                    rel="alternate"
                    hreflang={otherLocale}
                    href={new URL(alternate, Astro.site)}
                />
            </>
        )}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400..700&family=JetBrains+Mono:wght@500;700&display=swap"
        />
        <title>{title}</title>
    </head>

    <body>
        <a class="skip" href="#obsah" lang={locale}>
            {t("skip")}
        </a>
        <header class="site-header" lang={locale}>
            <a class="brand" href={homeUrl(locale)} aria-label={t("nav.home")}>
                <span class="brand-hold" aria-hidden="true">
                    ŠB
                </span>
                <span class="brand-name">Štefan Bartoš</span>
            </a>
            <nav aria-label={t("nav.label")}>
                <ul>
                    {nav.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                data-hold={item.hold}
                                hreflang={item.lang}
                                aria-current={current === item.href ? "page" : undefined}
                            >
                                {item.label}
                            </a>
                        </li>
                    ))}
                    <li>
                        <a
                            class="lang-switch mono"
                            href={switchHref}
                            hreflang={otherLocale}
                            lang={otherLocale}
                            title={t("lang.switch")}
                            aria-label={t("lang.switch")}
                        >
                            {t("lang.other")}
                        </a>
                    </li>
                </ul>
            </nav>
        </header>

        <main id="obsah" class:list={[wide ? "wide" : "prose"]}>
            {!wide && (
                <div class="page-banner" aria-hidden="true">
                    <Topo seed={title.length} peaks={[{ x: 85, y: 40, r: 60 }]} />
                </div>
            )}
            {frontmatter?.toc && <Toc headings={headings} />}
            <slot />
        </main>

        <footer class="site-footer" lang={locale}>
            <p>
                <span class="mono">Belay on.</span> © {new Date().getFullYear()} Štefan Bartoš ·
                <a href="https://github.com/stefanbartos">GitHub</a>
            </p>
        </footer>
    </body>
</html>
