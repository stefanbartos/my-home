---
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/inter-tight/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "../styles/global.css";
import type { MarkdownHeading } from "astro";
import Topo from "../components/Topo.astro";
import Toc from "../components/Toc.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Lightbox from "../components/Lightbox.astro";
import CodeCopy from "../components/CodeCopy.astro";
import themeInit from "../scripts/theme-init.js?raw";
import type { Locale } from "../i18n/ui";
import { contactUrl, defaultLocale, homeUrl, url, useTranslations } from "../i18n/ui";
import { currentYear, formatDate, isoDate, parseFrontmatterDate } from "../utils/date";
import { summaryDescription } from "../utils/seo";

interface Props {
    frontmatter?: {
        title?: string;
        description?: string;
        summary?: Partial<Record<Locale, string>>;
        lang?: string;
        toc?: boolean;
        /** Date of the last content edit (YAML parses `2026-11-19` as a Date). */
        updated?: Date | string;
    };
    headings?: MarkdownHeading[];
    title?: string;
    description?: string;
    /** Language of the page content (html lang). Defaults to the UI locale. */
    lang?: string;
    /** Language of the site chrome (nav, footer). */
    locale?: Locale;
    /** URL of this page in the other locale, if a translation exists. */
    alternate?: string;
    wide?: boolean;
}

const { frontmatter, headings = [], wide = false } = Astro.props;
const locale: Locale = Astro.props.locale ?? defaultLocale;
const otherLocale: Locale = locale === "sk" ? "en" : "sk";
const t = useTranslations(locale);

const pageTitle = Astro.props.title ?? frontmatter?.title;
const title = pageTitle ? `${pageTitle} · Štefan Bartoš` : "Štefan Bartoš";
const lang = Astro.props.lang ?? frontmatter?.lang ?? locale;
const description =
    Astro.props.description ??
    frontmatter?.description ??
    summaryDescription(frontmatter?.summary, lang, locale) ??
    t("site.description");
const alternate = Astro.props.alternate;
const updated =
    frontmatter?.updated === undefined ? null : parseFrontmatterDate(frontmatter.updated);
const switchHref = alternate ?? homeUrl(otherLocale);

const home = homeUrl(locale);
const nav = [
    { href: `${home}#posts`, label: t("nav.posts") },
    { href: `${home}#about`, label: t("nav.about") },
    { href: contactUrl(locale), label: t("nav.contact") },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f8f7f4" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#111318" media="(prefers-color-scheme: dark)" />
        {alternate && (
            <>
                <link
                    rel="alternate"
                    hreflang={locale}
                    href={new URL(Astro.url.pathname, Astro.site)}
                />
                <link
                    rel="alternate"
                    hreflang={otherLocale}
                    href={new URL(alternate, Astro.site)}
                />
            </>
        )}
        <link rel="sitemap" href={url("/sitemap-index.xml")} />
        <link rel="icon" href={url("/favicon.ico")} sizes="32x32" />
        <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
        <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
        <title>{title}</title>
        <script is:inline set:html={themeInit} />
        <!--
            GoatCounter: cookieless page-view stats; it ignores localhost by default.
            Load the versioned script with Subresource Integrity, so the browser
            refuses it if gc.zgo.at ever serves different code. The hash is the one
            published at https://www.goatcounter.com/help/countjs-versions. Update
            both the version and the hash together.
        -->
        <script
            is:inline
            data-goatcounter="https://stefanbartos.goatcounter.com/count"
            async
            src="https://gc.zgo.at/count.v4.js"
            crossorigin="anonymous"
            integrity="sha384-nRw6qfbWyJha9LhsOtSb2YJDyZdKvvCFh0fJYlkquSFjUxp9FVNugbfy8q1jdxI+"
        ></script>
    </head>

    <body>
        <a class="skip" href="#obsah" lang={locale}>
            {t("skip")}
        </a>
        <header class="site-header" lang={locale}>
            <a class="brand" href={homeUrl(locale)}>
                <span class="brand-hold" aria-hidden="true">
                    ŠB
                </span>
                <span class="brand-name">Štefan Bartoš</span>
            </a>
            <nav aria-label={t("nav.label")}>
                <ul>
                    {nav.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                aria-current={item.href === currentPath ? "page" : undefined}
                            >
                                {item.label}
                            </a>
                        </li>
                    ))}
                    <li>
                        <ThemeToggle label={t("theme.dark")} />
                    </li>
                    <li>
                        <a
                            class="lang-switch mono"
                            href={switchHref}
                            hreflang={otherLocale}
                            lang={otherLocale}
                            title={t("lang.switch")}
                            aria-label={`${t("lang.other")} – ${t("lang.switch")}`}
                        >
                            {t("lang.other")}
                        </a>
                    </li>
                </ul>
            </nav>
        </header>

        <main id="obsah" class:list={[wide ? "wide" : "prose"]}>
            {!wide && (
                <div class="page-banner" aria-hidden="true">
                    <Topo seed={title.length} peaks={[{ x: 85, y: 40, r: 60 }]} />
                </div>
            )}
            {frontmatter?.toc && <Toc headings={headings} lang={lang} />}
            <slot />
            {updated && (
                <p class="page-updated" lang={locale}>
                    {t("updated")}{" "}
                    <time datetime={isoDate(updated)}>{formatDate(locale, updated)}</time>
                </p>
            )}
        </main>

        <footer class="site-footer" lang={locale}>
            <p>
                © {currentYear()} Štefan Bartoš
                {" · "}
                <a href="https://github.com/stefanbartos">GitHub</a>
                {" · "}
                <a href="https://www.linkedin.com/in/stefan-bartos/">LinkedIn</a>
                {" · "}
                <a href={contactUrl(locale)}>{t("nav.contact")}</a>
            </p>
        </footer>

        {!wide && <CodeCopy labels={{ copy: t("code.copy"), copied: t("code.copied") }} />}
        {!wide && (
            <Lightbox
                labels={{
                    dialog: t("lightbox.label"),
                    close: t("lightbox.close"),
                    prev: t("lightbox.prev"),
                    next: t("lightbox.next"),
                }}
            />
        )}
    </body>
</html>

<style>
    .skip {
        position: absolute;
        left: 1rem;
        top: -4rem;
        z-index: 100;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        background: var(--ink);
        color: var(--bg);
    }
    .skip:focus {
        top: 1rem;
    }

    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem var(--gutter);
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1rem;
    }
    .brand:hover {
        color: inherit;
    }
    .brand-hold {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 8px;
        background: var(--ink);
        color: var(--bg);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .site-header ul {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .site-header nav a {
        position: relative;
        display: block;
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        color: var(--ink-soft);
        font-weight: 500;
        font-size: 0.92rem;
        text-decoration: none;
    }
    .site-header nav a:hover {
        color: var(--ink);
        background: color-mix(in srgb, var(--ink) 6%, transparent);
    }
    .site-header nav a[aria-current="page"] {
        color: var(--ink);
    }
    .site-header nav a[aria-current="page"]::after {
        content: "";
        position: absolute;
        left: 0.75rem;
        right: 0.75rem;
        bottom: -0.95rem;
        height: 2px;
        background: var(--accent);
    }

    /* Language switcher */
    .site-header nav .lang-switch {
        margin-left: 0.5rem;
        padding: 0.3rem 0.55rem;
        border: 1px solid var(--line);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.04em;
    }
    .site-header nav .lang-switch:hover {
        border-color: var(--ink-soft);
        background: transparent;
    }

    @media (max-width: 560px) {
        /* Hidden visually only: it stays the link's accessible name. */
        .brand-name {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }
        .site-header nav a {
            padding: 0.4rem 0.5rem;
            font-size: 0.85rem;
        }
    }

    .page-banner {
        position: absolute;
        z-index: -1;
        top: 0;
        left: calc(50% - 50vw);
        width: 100vw;
        height: 280px;
        opacity: 0.7;
        mask-image: linear-gradient(to bottom, #000 20%, transparent);
        -webkit-mask-image: linear-gradient(to bottom, #000 20%, transparent);
    }

    .page-updated {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--line);
        color: var(--ink-soft);
        font-size: 0.85rem;
    }

    .site-footer {
        padding: 2rem var(--gutter);
        border-top: 1px solid var(--line);
        color: var(--ink-soft);
        font-size: 0.875rem;
        text-align: center;
    }
    .site-footer p {
        margin: 0;
    }
</style>
