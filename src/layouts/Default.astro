---
import type { MarkdownHeading } from "astro";
import Toc from "../components/Toc.astro";

interface Props {
    frontmatter?: { title?: string; lang?: string; toc?: boolean };
    headings?: MarkdownHeading[];
    title?: string;
}

const { frontmatter, headings = [], title: titleProp } = Astro.props;
const title = titleProp ?? frontmatter?.title ?? "My home";
const lang = frontmatter?.lang ?? "cs";
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <style is:global>
            :root {
                color-scheme: light dark;
                --text: #1f2328;
                --muted: #59636e;
                --bg: #ffffff;
                --link: #0969da;
                --border: #d1d9e0;
            }
            @media (prefers-color-scheme: dark) {
                :root {
                    --text: #e6edf3;
                    --muted: #9198a1;
                    --bg: #0d1117;
                    --link: #4493f8;
                    --border: #3d444d;
                }
            }
            body {
                margin: 0;
                padding: 1.5rem 1rem 4rem;
                background: var(--bg);
                color: var(--text);
                font-family:
                    system-ui,
                    -apple-system,
                    "Segoe UI",
                    Roboto,
                    sans-serif;
                font-size: 1.0625rem;
                line-height: 1.6;
            }
            main {
                max-width: 48rem;
                margin: 0 auto;
            }
            h1,
            h2,
            h3 {
                line-height: 1.25;
                margin: 2em 0 0.5em;
            }
            h1 {
                margin-top: 0;
            }
            h3 {
                padding-top: 1em;
                border-top: 1px solid var(--border);
            }
            a {
                color: var(--link);
                overflow-wrap: anywhere;
            }
            ul,
            ol {
                padding-left: 1.5rem;
            }
            li + li {
                margin-top: 0.25em;
            }
            img {
                max-width: 100%;
                height: auto;
            }
            picture {
                display: block;
                margin: 1rem 0;
            }
        </style>
    </head>

    <body>
        <main>
            {frontmatter?.toc && <Toc headings={headings} />}
            <slot />
        </main>
    </body>
</html>
