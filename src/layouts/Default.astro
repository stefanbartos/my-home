---
import type { MarkdownHeading } from "astro";
import Toc from "../components/Toc.astro";

interface Props {
    frontmatter?: { title?: string; lang?: string; toc?: boolean };
    headings?: MarkdownHeading[];
    title?: string;
}

const { frontmatter, headings = [], title: titleProp } = Astro.props;
const title = titleProp ?? frontmatter?.title ?? "My home";
const lang = frontmatter?.lang ?? "cs";
---

<!DOCTYPE html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>

    <body>
        <main>
            {frontmatter?.toc && <Toc headings={headings} />}
            <slot />
        </main>
    </body>
</html>
