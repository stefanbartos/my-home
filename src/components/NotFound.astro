---
import Default from "../layouts/Default.astro";
import Button from "./Button.astro";
import Topo from "./Topo.astro";
import type { Locale } from "../i18n/ui";
import { homeUrl, url, useTranslations } from "../i18n/ui";

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const notFoundUrl = (lang: Locale) => url(lang === "sk" ? "/404/" : `/${lang}/404/`);
const otherLocale: Locale = locale === "sk" ? "en" : "sk";
const home = homeUrl(locale);

// GitHub Pages serves only the root 404.html, also for missing /en/ URLs.
// Send those visitors to the English 404 page instead.
const enPrefix = url("/en/");
const en404 = notFoundUrl("en");
---

<Default
    wide
    locale={locale}
    title={t("notFound.title")}
    description={t("notFound.text")}
    alternate={notFoundUrl(otherLocale)}
>
    <section
        class="not-found"
        data-en-prefix={locale === "sk" ? enPrefix : undefined}
        data-en404={locale === "sk" ? en404 : undefined}
    >
        <Topo class="not-found-topo" seed={404} peaks={[{ x: 50, y: 48, r: 58 }]} />
        <h1 class="not-found-title">
            <span class="not-found-code mono">404</span>
            {t("notFound.title")}
        </h1>
        <p class="not-found-text">{t("notFound.text")}</p>
        <div class="not-found-actions">
            <Button href={home} label={t("notFound.home")} />
        </div>
    </section>
</Default>

<script>
    // Bundled (not is:inline) so the CSP covers it. Only the Slovak page sets the data.
    const notFound = document.querySelector<HTMLElement>(".not-found");
    const { enPrefix, en404 } = notFound?.dataset ?? {};
    if (enPrefix && en404 && location.pathname.startsWith(enPrefix)) {
        location.replace(en404);
    }
</script>

<style>
    .not-found {
        position: relative;
        isolation: isolate;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: min(60vh, 560px);
        max-width: 720px;
        margin: 0 auto;
        padding: clamp(3rem, 8vw, 5rem) var(--gutter);
        text-align: center;
    }
    /* The <svg> is rendered by Topo.astro, so it doesn't carry this scope. */
    .not-found :global(.not-found-topo) {
        position: absolute;
        inset: 0;
        z-index: -1;
        left: calc(50% - 50vw);
        width: 100vw;
        max-width: none;
        opacity: 0.6;
        mask-image: radial-gradient(ellipse at center, #000 35%, transparent 72%);
        -webkit-mask-image: radial-gradient(ellipse at center, #000 35%, transparent 72%);
    }
    .not-found-title {
        margin: 0;
        font-size: clamp(2rem, 1.6rem + 2vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.25rem 1rem;
    }
    .not-found-code {
        padding-right: 1rem;
        border-right: 1px solid var(--line);
        color: var(--accent);
        font-size: 0.6em;
        font-weight: 600;
        letter-spacing: 0;
    }
    .not-found-text {
        max-width: 44ch;
        margin: 1rem 0 0;
        font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
        color: var(--ink-soft);
    }
    .not-found-actions {
        margin-top: 2rem;
    }
</style>
