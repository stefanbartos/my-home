---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const links = [
    { href: `${base}/`, label: "Domů" },
    { href: `${base}/sci/`, label: "SCI" },
    { href: `${base}/prvni-pomoc/`, label: "Prvni pomoc" },
];

const current = Astro.url.pathname.replace(/\/?$/, "/");
---

<nav aria-label="Hlavní navigace">
    <ul>
        {links.map(({ href, label }) => (
            <li>
                <a href={href} aria-current={current === href ? "page" : undefined}>
                    {label}
                </a>
            </li>
        ))}
    </ul>
</nav>

<style>
    nav {
        max-width: 48rem;
        margin: 0 auto 2rem;
    }
    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }
    a {
        text-decoration: none;
    }
    a[aria-current="page"] {
        font-weight: 600;
        text-decoration: underline;
    }
</style>
