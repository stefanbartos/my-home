---
interface Props {
    url: string;
    title?: string;
}

const { url, title } = Astro.props;
const id = new URL(url).searchParams.get("v");
---

<div style="padding-bottom:56.25%; position:relative; display:block; width: 100%; max-width: 1200px">
    <iframe
        class="yt-shortcode"
        src={`https://www.youtube-nocookie.com/embed/${id}`}
        title={`YouTube video player${title ? ` for ${title}` : ""}`}
        width="100%"
        height="100%"
        frameborder="0"
        allowfullscreen
        style="position:absolute; top:0; left: 0"></iframe>
</div>
