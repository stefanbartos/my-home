---
// First used by the Malá Fatra page (PR #100); remove this line there.
// fallow-ignore-file unused-file
interface Props {
    /** The src of the code from mapy.com "Share → Embed map", e.g. https://mapy.com/s/jepocatupo */
    url: string;
    /** Describes the map for screen readers, e.g. the route name. */
    title: string;
}

const { url, title } = Astro.props;

// Only the embed code from mapy.com's "Share → Embed map" dialog works in an iframe.
// Its src is a share link like https://mapy.com/s/<code>.
if (!/^https:\/\/mapy\.com\/s\/[^/?]+$/u.test(url)) {
    throw new Error(`MapyEmbed: "${url}" is not a mapy.com embed link (https://mapy.com/s/<code>)`);
}
---

<div class="mapy">
    <iframe
        src={url}
        title={title}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
    ></iframe>
</div>

<style>
    .mapy {
        margin: 1.5rem 0;
    }
    iframe {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        height: auto;
        border: 0;
        border-radius: 8px;
    }
</style>
