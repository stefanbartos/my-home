---
/**
 * Grid of smaller photos. Wrap `Img` components in it: each photo becomes an
 * equal-sized thumbnail (cropped to 3:4), and the lightbox still shows it whole.
 */
---

<div class="gallery">
    <slot />
</div>

<style>
    .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
        gap: 1.25rem 1rem;
        margin: 1.5rem 0;
    }
    /* Img renders this markup, so it needs :global(). The extra class names
       outweigh Img's own sizing rules for wide and tall photos. */
    .gallery :global(.img),
    .gallery :global(.img.wide),
    .gallery :global(.img.tall) {
        width: 100%;
        max-width: none;
        margin: 0;
    }
    .gallery :global(.img.img .img-zoom img) {
        width: 100%;
        max-width: none;
        height: auto;
        max-height: none;
        aspect-ratio: 3 / 4;
        object-fit: cover;
    }
</style>
