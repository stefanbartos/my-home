---
/**
 * Adds a "copy" button to the top-right corner of every code block in the
 * page content. Without JavaScript (or the Clipboard API) nothing is added.
 */
interface Props {
    labels: { copy: string; copied: string };
}

const { labels } = Astro.props;
---

<template id="code-copy-template" data-copy={labels.copy} data-copied={labels.copied}>
    <button class="code-copy" type="button" aria-label={labels.copy} title={labels.copy}>
        <svg class="code-copy-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15V6a2 2 0 0 1 2-2h8"></path>
        </svg>
        <svg class="code-copy-done" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12.5l4.5 4.5L19 7"></path>
        </svg>
    </button>
</template>

<script>
    const template = document.querySelector<HTMLTemplateElement>("#code-copy-template");
    const buttonTemplate = template?.content.firstElementChild;

    if (template && buttonTemplate && navigator.clipboard) {
        const { copy = "", copied = "" } = template.dataset;

        for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
            // Wrap the <pre> so the button stays put while the code scrolls sideways.
            const wrapper = document.createElement("div");
            wrapper.className = "code-block";
            pre.before(wrapper);
            wrapper.append(pre);

            const button = buttonTemplate.cloneNode(true) as HTMLButtonElement;
            wrapper.append(button);

            let timer: ReturnType<typeof setTimeout> | undefined;
            button.addEventListener("click", async () => {
                const text = (pre.querySelector("code") ?? pre).textContent ?? "";
                try {
                    await navigator.clipboard.writeText(text.replace(/\n$/u, ""));
                } catch {
                    return;
                }
                button.classList.add("is-copied");
                button.ariaLabel = copied;
                button.title = copied;
                clearTimeout(timer);
                timer = globalThis.setTimeout(() => {
                    button.classList.remove("is-copied");
                    button.ariaLabel = copy;
                    button.title = copy;
                }, 2000);
            });
        }
    }
</script>

<!-- Global: the script creates the .code-block wrapper, so it has no scope attribute. -->
<style is:global>
    .code-block {
        position: relative;
        margin: 1.25rem 0;
    }
    .code-block pre {
        margin: 0;
        padding-right: 3.25rem;
    }
    .code-copy {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: 1px solid rgb(255 255 255 / 0.12);
        border-radius: 6px;
        background: rgb(255 255 255 / 0.06);
        color: #c9d1d9;
        cursor: pointer;
        transition:
            background-color 0.15s,
            color 0.15s;
    }
    .code-copy:hover {
        background: rgb(255 255 255 / 0.14);
        color: #fff;
    }
    .code-copy:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }
    .code-copy svg {
        grid-area: 1 / 1;
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .code-copy .code-copy-done,
    .code-copy.is-copied .code-copy-icon {
        visibility: hidden;
    }
    .code-copy.is-copied .code-copy-done {
        visibility: visible;
    }
    .code-copy.is-copied {
        color: #7ee787;
    }
</style>
