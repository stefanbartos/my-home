---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
}

// Page title (h1) is skipped; h2 and h3 sections are listed.
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
    <details class="toc">
        <summary>Obsah</summary>
        <ul>
            {items.map((h) => (
                <li class={`depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                </li>
            ))}
        </ul>
    </details>
)}

<style>
    .toc {
        margin: 0 0 2.5rem;
        padding: 0.9rem 1.15rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: var(--bg-raised);
    }
    summary {
        cursor: pointer;
        font-family: var(--font-display);
        font-weight: 600;
    }
    summary::marker {
        color: var(--ink-soft);
    }
    /* .toc in front so these beat the global .prose ul / .prose li rules. */
    .toc ul {
        margin: 0.75rem 0 0;
        padding-left: 0;
        list-style: none;
    }
    .toc li {
        margin: 0.2rem 0;
    }
    a {
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
    .toc .depth-3 {
        margin-left: 1rem;
        font-size: 0.95em;
        color: var(--ink-soft);
    }
</style>
