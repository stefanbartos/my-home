{
  "ci": {
    "collect": {
      "staticDistDir": ".lighthouseci/site",
      "url": [
        "http://localhost/my-home/",
        "http://localhost/my-home/sci/",
        "http://localhost/my-home/frontend-best-practices/",
        "http://localhost/my-home/kontakt/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "total-byte-weight": ["error", { "maxNumericValue": 768000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
