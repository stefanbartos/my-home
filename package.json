{
  "name": "my-home",
  "version": "1.0.0",
  "private": true,
  "description": "Personal home page",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fallow": "fallow --fail-on-issues",
    "check": "astro check",
    "check:a11y": "node scripts/check-a11y.ts",
    "prepare": "lefthook install",
    "test": "vitest run",
    "lighthouse": "rm -rf .lighthouseci && mkdir -p .lighthouseci/site && cp -R dist .lighthouseci/site/my-home && lhci autorun"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanbartos/my-home.git"
  },
  "keywords": [],
  "author": "Stefan Bartos",
  "bugs": {
    "url": "https://github.com/stefanbartos/my-home/issues"
  },
  "homepage": "https://github.com/stefanbartos/my-home#readme",
  "type": "module",
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "~7.4"
  },
  "allowScripts": {
    "fsevents": false,
    "lefthook": false
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.3",
    "@astrojs/sitemap": "^3.7.5",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "fallow": "^3.43.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.4"
  }
}
