{
  "name": "my-home",
  "version": "1.0.0",
  "private": true,
  "description": "Personal home page",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fallow": "fallow --fail-on-issues",
    "prepare": "lefthook install",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanbartos/my-home.git"
  },
  "keywords": [],
  "author": "Stefan Bartos",
  "bugs": {
    "url": "https://github.com/stefanbartos/my-home/issues"
  },
  "homepage": "https://github.com/stefanbartos/my-home#readme",
  "type": "module",
  "dependencies": {
    "@astrojs/mdx": "^8.1.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "~7.4"
  },
  "allowScripts": {
    "fsevents": false,
    "lefthook": false
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.3",
    "@astrojs/sitemap": "^3.7.4",
    "fallow": "^3.38.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "vitest": "^5.1.0"
  }
}
